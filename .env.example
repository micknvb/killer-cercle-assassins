# ============================================================================
# Le Cercle des Assassins (Jeu du Killer) — Configuration (.env.example)
# Copiez ce fichier en `.env` et personnalisez les valeurs avant déploiement.
# ============================================================================

# Mot de passe de l'interface Maître du Jeu (/admin)
ADMIN_PASSWORD=ChangeMe-SecretGM-Password!

# URL publique du site (utilisée pour générer les liens personnels /p/<token> dans les SMS/WhatsApp)
PUBLIC_URL=https://killer.example.com

# Port interne du serveur Node.js
PORT=3000

# Répertoire de stockage persistant (monté via volume Docker)
DATA_DIR=/data
